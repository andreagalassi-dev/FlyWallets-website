# FlyWallets - Docker Compose settings (copy to .env next to docker-compose.yml; NEVER commit .env).
# Used by `docker compose up --build`. Local, non-Docker development uses backend/.env instead.

# --- Strongly recommended: >= 32 random chars each ---
# (If left empty the backend generates random secrets at startup and warns: fine for a demo, but every restart logs everybody out.)
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# or: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Host ports (change them if the defaults are busy) ---
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Browser origin(s) allowed by CORS (comma-separated; the first one is used in e-mail links).
# Defaults to http://localhost:${FRONTEND_PORT}. NEXT_PUBLIC_API_URL is derived from BACKEND_PORT at build time
# (re-run `docker compose up --build` after changing BACKEND_PORT).
# CLIENT_URL=http://localhost:3000

# Database passwords (dev defaults shown). APP_DB_PASSWORD is the restricted `flywallets_app` role that makes
# Row-Level Security effective; it is created on the first start of an EMPTY volume (docker compose down -v to redo).
# Use alphanumeric characters only.
# POSTGRES_PASSWORD=postgres
# APP_DB_PASSWORD=flywallets_app

# --- Optional: e-mail (without credentials, codes and links are printed in `docker compose logs backend`) ---
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="FlyWallets <no-reply@flywallets.local>"
RESEND_API_KEY=

# --- Optional: SMS ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Optional: AI (gemini | openai | disabled) ---
AI_PROVIDER=disabled
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Not forwarded by docker-compose.yml ---
# These backend variables (see backend/.env.example) are NOT passed to the container as shipped: DATABASE_APP_URL,
# REQUIRE_VERIFIED_EMAIL, TRUST_PROXY, RECURRING_SCHEDULER, GEMINI_MODEL, OPENAI_MODEL. Add them to the
# `backend.environment` block of docker-compose.yml if you need them. Without DATABASE_APP_URL the Docker stack
# connects as the postgres superuser, so Row-Level Security policies exist but are not enforced.
