# FlyWallets Backend Environment Variables
# Copy to backend/.env and adjust. NEVER commit the real .env file.

# macOS: the AirPlay Receiver may occupy port 5000 -> use PORT=5055 and set NEXT_PUBLIC_API_URL=http://localhost:5055/api in frontend/.env.local
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS. Comma-separated for more than one.
# The FIRST one is used to build links in e-mails (password reset).
CLIENT_URL=http://localhost:3000

# Set to the number of reverse proxies in front of the API (e.g. 1 on Render/Heroku/nginx)
# so rate limiting sees the real client IP. Leave unset when running locally.
# TRUST_PROXY=1

# --- Database (PostgreSQL) ---
# Local Docker, database only: docker compose up -d postgres (compose needs JWT_SECRET / JWT_REFRESH_SECRET defined,
# see the root .env.example). If 5432 is busy, set POSTGRES_PORT=5433 and use that port below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flywallets
# Set DB_SSL=false for local PostgreSQL without SSL
DB_SSL=false
# Optional: restricted role so Row-Level Security is actually enforced (see database/rls_app_role.sql).
# Without it the policies exist but the owner/superuser bypasses them.
# DATABASE_APP_URL=postgresql://flywallets_app:change_me@localhost:5432/flywallets

# --- Auth (REQUIRED in production, >= 32 random chars each) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- E-mail (optional: without credentials codes and links are printed in the backend console) ---
# Option A - SMTP (Mailtrap, Mailpit, Gmail, SES...)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="FlyWallets <no-reply@flywallets.local>"
# Option B - Resend (takes precedence over SMTP). SMTP_FROM must then use a domain verified in Resend.
RESEND_API_KEY=

# --- SMS (optional: without credentials messages are printed in the console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- AI (optional): gemini | openai | disabled ---
# With "disabled" (or a missing key) categorization uses a keyword engine and insights use fixed rules.
AI_PROVIDER=disabled
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# E-mail verification gate (default false). When "true", users whose e-mail is not verified can read their
# data but every write on accounts / transactions / goals / categories / budgets / recurring / data (CSV)
# is refused with 403 { "code": "EMAIL_NOT_VERIFIED" }. Auth routes are never gated.
REQUIRE_VERIFIED_EMAIL=false

# Recurring transactions are generated by a background scheduler in the API process (at startup, then hourly).
# Set to "off" to disable it (due rules are still processed when the recurring list/API is used).
# RECURRING_SCHEDULER=off

# --- Abuse protection / database pool (all optional, defaults shown) ---
# IMPORT_RATE_LIMIT_PER_MIN=5          # CSV imports per user per minute
# EXPORT_RATE_LIMIT_PER_MIN=10         # CSV exports per user per minute
# EXPORT_MAX_CONCURRENT_PER_USER=2     # simultaneous exports per user (in-memory: use a shared store with several instances)
# EXPORT_DRAIN_TIMEOUT_MS=30000        # drop clients that stop reading an export
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=15000        # 0 disables; raise/disable for very long manual migrations
# DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=30000
# SCHEDULER_USER_BUDGET_MS=5000        # recurring-transactions scheduler: max time per user per run
