# FlyWallets PRODUCTION settings. Copy to deploy/.env (git-ignored, NEVER commit it) and edit:
#   cp deploy/production.env.example deploy/.env
# Used with:
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build
#
# The values below marked CHANGE_ME are deliberately fake placeholders so `docker compose config` works in CI.
# Do not deploy them: replace every CHANGE_ME.

# --- Public host name (REQUIRED) ---------------------------------------------------------------------------
# Host name only, no scheme, no path. Its DNS A/AAAA record must point at this server and ports 80 + 443 must be
# reachable from the internet, otherwise Caddy cannot obtain the HTTPS certificate.
# The web app AND the API are served from this single domain (required by the SameSite=Strict cookies).
DOMAIN=wallet.example.com

# --- Secrets (REQUIRED) ------------------------------------------------------------------------------------
# JWT secrets: >= 32 random chars each, DIFFERENT from each other. Generate each with:
#   openssl rand -hex 48
#   (or: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_48_0000
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_one_with_openssl_rand_hex_48
# Database passwords: ALPHANUMERIC ONLY (they are embedded in connection URLs). Generate with:
#   openssl rand -hex 24
# POSTGRES_PASSWORD is the superuser (auth flows); APP_DB_PASSWORD is the restricted `flywallets_app` role that
# makes Row-Level Security effective. Both are applied on the FIRST start of an EMPTY database volume only:
# changing them later does not change the existing database (use ALTER ROLE ... PASSWORD, see deploy/README.md).
POSTGRES_PASSWORD=CHANGE_ME0postgres0password
APP_DB_PASSWORD=CHANGE_ME0app0role0password

# --- Host ports published by Caddy (defaults shown) ----------------------------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Compose project name (container/volume prefix; default shown) ------------------------------------------
# COMPOSE_PROJECT_NAME=flywallets

# --- E-mail -----------------------------------------------------------------------------------------------
# Without credentials verification codes and reset links are only PRINTED in `docker compose logs backend`
# (fine for a private instance, useless for real users). Configure ONE provider:
# Option A - SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587/2525 (STARTTLS)
SMTP_SECURE=false
SMTP_FROM="FlyWallets <no-reply@wallet.example.com>"
# Option B - Resend (takes precedence over SMTP). SMTP_FROM must use a domain verified in Resend.
RESEND_API_KEY=

# Recommended: set to true once an e-mail provider works. Users with an unverified e-mail can then read their
# data but not create or change anything (403 EMAIL_NOT_VERIFIED), so throw-away addresses cannot be used to
# fill the database. Leave false if you have NO e-mail provider: nobody could read the verification code and
# every user would be stuck read-only.
REQUIRE_VERIFIED_EMAIL=false

# Background scheduler for recurring transactions, runs inside the API process (on | off)
RECURRING_SCHEDULER=on

# --- Optional: SMS ----------------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Optional: AI (gemini | openai | disabled) ------------------------------------------------------------
# With "disabled" (or a missing key) categorization uses a keyword engine and insights use fixed rules.
AI_PROVIDER=disabled
GEMINI_API_KEY=
# GEMINI_MODEL=
OPENAI_API_KEY=
# OPENAI_MODEL=

# --- LOCAL TESTING ONLY ------------------------------------------------------------------------------------
# Any non-empty value makes Caddy use a self-signed certificate from its own private CA (for DOMAIN=localhost
# or a LAN name). NEVER set it for a real domain: browsers would show a certificate error to your users.
# TLS_INTERNAL=true
